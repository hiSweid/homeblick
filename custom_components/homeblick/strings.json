{
  "config": {
    "step": {
      "user": {
        "title": "Homeblick",
        "description": "Adds the Homeblick wall display panel to the sidebar."
      }
    },
    "abort": {
      "single_instance_allowed": "Homeblick is already set up."
    }
  },
  "entity": {
    "select": {
      "face": {
        "name": "Face",
        "state": {
          "bigclock": "Digital clock",
          "analog": "Analog clock",
          "weather": "Weather",
          "music": "Music",
          "grid": "Smart home",
          "calendar": "Calendar",
          "date": "Date",
          "energy": "Energy",
          "info": "Info",
          "cams": "Cameras"
        }
      },
      "saver": {
        "name": "Screensaver face",
        "state": {
          "bigclock": "Digital clock",
          "analog": "Analog clock",
          "weather": "Weather",
          "music": "Music",
          "grid": "Smart home",
          "calendar": "Calendar",
          "date": "Date",
          "energy": "Energy",
          "info": "Info",
          "cams": "Cameras"
        }
      },
      "wake": {
        "name": "Wake word",
        "state": {
          "off": "Off",
          "hey_jarvis": "Hey Jarvis",
          "alexa": "Alexa"
        }
      }
    },
    "switch": {
      "screensaver": {
        "name": "Screensaver"
      },
      "dim": {
        "name": "Night dimming"
      },
      "mute": {
        "name": "Mute replies"
      },
      "barge": {
        "name": "Wake word interrupts reply"
      },
      "music": {
        "name": "Music instead of screensaver"
      },
      "chime": {
        "name": "Doorbell chime"
      },
      "black": {
        "name": "Screensaver black"
      },
      "hold": {
        "name": "Screensaver hold"
      },
      "perf": {
        "name": "Performance mode"
      },
      "sched": {
        "name": "Screensaver schedule"
      }
    },
    "button": {
      "reload": {
        "name": "Reload"
      },
      "assist": {
        "name": "Assist"
      }
    },
    "number": {
      "idle": {
        "name": "Screensaver delay"
      },
      "dim_level": {
        "name": "Dim level"
      },
      "listen": {
        "name": "Listening timeout"
      },
      "volume": {
        "name": "Reply volume"
      },
      "bright": {
        "name": "Brightness"
      }
    },
    "time": {
      "dim_from": {
        "name": "Dim from"
      },
      "dim_to": {
        "name": "Dim until"
      },
      "sched_from": {
        "name": "Screensaver schedule from"
      },
      "sched_to": {
        "name": "Screensaver schedule until"
      }
    },
    "binary_sensor": {
      "online": {
        "name": "Online"
      }
    },
    "sensor": {
      "seen": {
        "name": "Last seen"
      },
      "shown_face": {
        "name": "Face shown"
      },
      "resolution": {
        "name": "Resolution"
      }
    },
    "notify": {
      "announce": {
        "name": "Announcement"
      }
    },
    "light": {
      "screen": {
        "name": "Screen"
      }
    }
  },
  "services": {
    "show_camera": {
      "name": "Show camera",
      "description": "Opens a camera full screen on the display, e.g. on motion.",
      "fields": {
        "display": {
          "name": "Display",
          "description": "Homeblick displays (only open ones react)."
        },
        "camera": {
          "name": "Camera",
          "description": "Camera to show."
        },
        "duration": {
          "name": "Duration",
          "description": "Closes after this many seconds; 0 keeps it open until someone closes it."
        }
      }
    },
    "hide_camera": {
      "name": "Hide camera",
      "description": "Closes the full-screen camera on the display.",
      "fields": {
        "display": {
          "name": "Display",
          "description": "Homeblick displays."
        }
      }
    }
  },
  "exceptions": {
    "no_display": {
      "message": "The selected device is not a Homeblick display."
    }
  },
  "issues": {
    "offline": {
      "title": "Display {name} is offline",
      "description": "The Homeblick display **{name}** has had no open panel for 10 minutes. Check that the device is switched on, connected to the network and showing the Homeblick page. This message disappears as soon as the display connects again."
    }
  }
}
